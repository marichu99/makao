DATABASE_URL=postgresql://makao:makao@localhost:5432/makao
JWT_SECRET_KEY=change-me-in-production
FLASK_ENV=development

# Used once, by `flask init-db`, to create the role/database above if they don't exist yet.
# Defaults to the local `postgres` superuser with no password (trust/peer auth).
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASSWORD=
# Or set a full admin connection string instead of the two vars above:
# DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Welcome email on signup. Left blank, registration still works — email is just skipped.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Used to build the "Go to your dashboard" link in the welcome email.
FRONTEND_URL=http://localhost:5173
